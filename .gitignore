# Unity generated folders (in root or any subfolder like game-client/)
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ibrary/
**/[Ll]ocal[Cc]ache/
**/[Ll]ogs/
**/[Mm]emoryCaptures/
**/[Oo]bj/
**/[Rr]ecordings/
**/[Tt]emp/
**/[Uu]ser[Ss]ettings/
**/.utmp/

# StreamingAssets addressables
**/[Aa]ssets/[Ss]treamingAssets/aa/*
**/[Aa]ssets/[Ss]treamingAssets/aa.meta

# Asset meta data should only be ignored when the corresponding asset is also ignored
!**/[Aa]ssets/**/*.meta

# Autogenerated JetBrains Rider plugin
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code cache directory
.vs/
.idea/
.gradle/
*.sln.DotSettings.user

# Autogenerated VS/MD/Consulo solution and project files
**/ExportedObj/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.ipa
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary cache files generated during packaging
**/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment and secrets (Backend / Local configs)
.env
.env.*
!.env.example
appsettings*.Development.json
secrets.json
*.key
*.pem
*.pfx

# Node / Web Backend
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database data dumps / local sqlite files
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
